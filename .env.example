# Required browser-safe Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Required server-only configuration
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ADMIN_EMAILS=admin@example.com
APP_URL=http://localhost:3000
TOKEN_HASH_SECRET=replace-with-at-least-32-random-characters

# Optional submission notification
EMAIL_PROVIDER_API_KEY=
SUBMISSION_NOTIFICATION_EMAIL=
EMAIL_FROM=

# Optional sanitized Google Sheets summary mirror
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_SECRET=
